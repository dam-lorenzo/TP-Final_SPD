@ECHO OFF
SETLOCAL

REM Requiere TASM y TLINK en el PATH.

ECHO [1/5] Ensamblando INT.ASM...
TASM /M2 INT.ASM
IF ERRORLEVEL 1 GOTO ERROR

ECHO [2/5] Generando INT.COM...
TLINK /T INT.OBJ
IF ERRORLEVEL 1 GOTO ERROR

ECHO [3/5] Instalando la interrupcion...
INT.COM
IF ERRORLEVEL 1 GOTO ERROR

ECHO [4/5] Ensamblando archivos del programa...
TASM /M2 MAIN.ASM
IF ERRORLEVEL 1 GOTO ERROR

TASM /M2 LIB.ASM
IF ERRORLEVEL 1 GOTO ERROR

TASM /M2 RANDOM.ASM
IF ERRORLEVEL 1 GOTO ERROR

ECHO [5/5] Enlazando MAIN.COM...
TLINK /T MAIN.OBJ LIB.OBJ RANDOM.OBJ
IF ERRORLEVEL 1 GOTO ERROR

ECHO Ejecutando MAIN.COM...
MAIN.COM
GOTO FIN

:ERROR
ECHO ERROR: fallo la compilacion o instalacion.


:FIN
ECHO Proceso finalizado.
